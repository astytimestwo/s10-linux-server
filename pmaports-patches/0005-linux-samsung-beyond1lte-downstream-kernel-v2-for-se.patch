diff --git a/device/archived/linux-samsung-beyond1lte-downstream/tzdev-idle-waits.patch b/device/archived/linux-samsung-beyond1lte-downstream/tzdev-idle-waits.patch
new file mode 100644
index 0000000000..7ea16b9f81
--- /dev/null
+++ b/device/archived/linux-samsung-beyond1lte-downstream/tzdev-idle-waits.patch
@@ -0,0 +1,134 @@
+diff -ruN a/drivers/misc/tzdev/tz_iwsock.c b/drivers/misc/tzdev/tz_iwsock.c
+--- a/drivers/misc/tzdev/tz_iwsock.c	2026-11-11 06:30:02.000242118 +0000
++++ b/drivers/misc/tzdev/tz_iwsock.c	2026-11-11 06:30:02.076242123 +0000
+@@ -37,9 +37,24 @@
+ #include <linux/sched/signal.h>
+ #endif
+ 
++/*
++ * Sleep as TASK_IDLE instead of TASK_UNINTERRUPTIBLE. The TEE kernel threads
++ * (tz_worker_thread, tz_iwsock, ree_time, scsi_srpmb_worker) wait here forever
++ * and every uninterruptible sleeper counts as load, which kept the load average
++ * at ~11 on an idle system. Same semantics as the plain wait_event macro; like the
++ * wait_event_idle() of Linux 4.17+.
++ */
++#define tz_wait_event_idle(wq_head, condition)					\
++do {										\
++	might_sleep();								\
++	if (condition)								\
++		break;								\
++	(void)___wait_event(wq_head, condition, TASK_IDLE, 0, 0, schedule());	\
++} while (0)
++
+ #if LINUX_VERSION_CODE < KERNEL_VERSION(3, 19, 0)
+ #define tz_iwsock_wait_event(wq, condition)					\
+-	wait_event(wq, condition)
++	tz_wait_event_idle(wq, condition)
+ 
+ #define tz_iwsock_wait_event_interruptible(wq, condition)			\
+ 	wait_event_interruptible(wq, condition)
+@@ -49,7 +64,7 @@
+ 	DEFINE_WAIT_FUNC(wait, woken_wake_function);				\
+ 	add_wait_queue(&wq, &wait);						\
+ 	while (!(condition))							\
+-		wait_woken(&wait, TASK_UNINTERRUPTIBLE,				\
++		wait_woken(&wait, TASK_IDLE,				\
+ 			MAX_SCHEDULE_TIMEOUT);					\
+ 	remove_wait_queue(&wq, &wait);						\
+ })
+@@ -397,7 +412,7 @@
+ 	smp_wmb();
+ 
+ 	mutex_lock(&nwd_events_list_lock);
+-	wait_event(tz_iwsock_full_event_buf_wq,
++	tz_wait_event_idle(tz_iwsock_full_event_buf_wq,
+ 			(ret = tz_iwsock_try_write_swd_event(sid)) != -EAGAIN);
+ 	mutex_unlock(&nwd_events_list_lock);
+ 
+@@ -427,7 +442,7 @@
+ 
+ static void tz_iwsock_notify_internally(int32_t sid)
+ {
+-	wait_event(internal_events_wq,
++	tz_wait_event_idle(internal_events_wq,
+ 			tz_iwsock_try_write_internal_event(sid) != -EAGAIN);
+ 	wake_up(&tz_iwsock_wq);
+ }
+@@ -748,7 +763,7 @@
+ 	}
+ 
+ 	if (sd->is_kern)
+-		wait_event(sd->wq,
++		tz_wait_event_idle(sd->wq,
+ 				!tz_iwsock_check_ready() ||
+ 				tz_iwsock_is_connection_done(sd));
+ 	else
+@@ -790,7 +805,7 @@
+ 	int ret = 0;
+ 
+ 	if (sd->is_kern)
+-		wait_event(tz_iwsock_wq, tz_iwsock_check_init_done() != -EAGAIN);
++		tz_wait_event_idle(tz_iwsock_wq, tz_iwsock_check_init_done() != -EAGAIN);
+ 	else if ((ret = wait_event_interruptible(
+ 				tz_iwsock_wq, tz_iwsock_check_init_done() != -EAGAIN)))
+ 		return ret;
+@@ -849,7 +864,7 @@
+ 
+ 	mutex_lock(&sd->lock);
+ 	if (sd->is_kern)
+-		wait_event(sd->wq, !tz_iwsock_check_ready() ||
++		tz_wait_event_idle(sd->wq, !tz_iwsock_check_ready() ||
+ 			sd->state != TZ_SK_LISTENING ||
+ 			!circ_buf_is_empty(&sd->read_buf));
+ 	else if ((res = wait_event_interruptible(sd->wq,
+@@ -917,7 +932,7 @@
+ socket_allocation_failed:
+ 	/* Write swd_id to unblock waiting threads in SWd */
+ 	mutex_lock(&sd->lock);
+-	wait_event(sd->wq, tz_iwsock_try_write(&sd->write_buf,
++	tz_wait_event_idle(sd->wq, tz_iwsock_try_write(&sd->write_buf,
+ 			&conn_req.swd_id, sizeof(conn_req.swd_id)) != -EAGAIN);
+ 	mutex_unlock(&sd->lock);
+ 
+@@ -948,7 +963,7 @@
+ 		while (sd->iwd_buf->swd_state != BUF_SK_CLOSED &&
+ 				circ_buf_read(&sd->read_buf, (char *)&conn_req,
+ 				sizeof(conn_req), CIRC_BUF_MODE_KERNEL) > 0) {
+-			wait_event(sd->wq, tz_iwsock_try_write(&sd->write_buf,
++			tz_wait_event_idle(sd->wq, tz_iwsock_try_write(&sd->write_buf,
+ 					(char *)&conn_req.swd_id, sizeof(conn_req.swd_id)) != -EAGAIN);
+ 		}
+ 
+@@ -1257,7 +1272,7 @@
+ 	(void)data;
+ 
+ 	while (!kthread_should_stop()) {
+-		wait_event(tz_iwsock_wq,
++		tz_wait_event_idle(tz_iwsock_wq,
+ 				!circ_buf_is_empty(&swd_sock_events) ||
+ 				!circ_buf_is_empty(&internal_events_out) ||
+ 				kthread_should_stop());
+diff -ruN a/drivers/misc/tzdev/tz_kthread_pool_notifier.c b/drivers/misc/tzdev/tz_kthread_pool_notifier.c
+--- a/drivers/misc/tzdev/tz_kthread_pool_notifier.c	2026-11-11 06:30:02.012242119 +0000
++++ b/drivers/misc/tzdev/tz_kthread_pool_notifier.c	2026-11-11 06:30:02.076242123 +0000
+@@ -119,7 +119,7 @@
+ 	DEFINE_WAIT_FUNC(wait, tz_kthread_pool_wake_function);
+ 
+ 	for (;;) {
+-		prepare_to_wait(&tz_cmd_waitqueue, &wait, TASK_UNINTERRUPTIBLE);
++		prepare_to_wait(&tz_cmd_waitqueue, &wait, TASK_IDLE);
+ 		ret = tz_kthread_pool_should_wake(cpu);
+ 		if (ret != KTHREAD_SHOULD_SLEEP)
+ 			break;
+diff -ruN a/drivers/misc/tzdev/tz_kthread_pool_smpboot.c b/drivers/misc/tzdev/tz_kthread_pool_smpboot.c
+--- a/drivers/misc/tzdev/tz_kthread_pool_smpboot.c	2026-11-11 06:30:02.008242119 +0000
++++ b/drivers/misc/tzdev/tz_kthread_pool_smpboot.c	2026-11-11 06:30:02.076242123 +0000
+@@ -126,7 +126,7 @@
+ 	DEFINE_WAIT_FUNC(wait, tz_kthread_pool_wake_function);
+ 
+ 	for (;;) {
+-		prepare_to_wait(&tz_cmd_waitqueue, &wait, TASK_UNINTERRUPTIBLE);
++		prepare_to_wait(&tz_cmd_waitqueue, &wait, TASK_IDLE);
+ 		ret = tz_kthread_pool_should_wake(cpu);
+ 		if (ret != KTHREAD_SHOULD_SLEEP)
+ 			break;
