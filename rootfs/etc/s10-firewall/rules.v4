# S10 IPv4 firewall (iptables-legacy-restore format). Loaded all-or-nothing:
# if any line is wrong, nothing is applied and the old rules stay.
# !! Change 192.168.1.0/24 to YOUR home subnet, or SSH over Wi-Fi gets blocked
# !! (USB and Tailscale stay open).
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
# USB networking from the PC and Tailscale: always allowed
-A INPUT -i usb0 -j ACCEPT
-A INPUT -i ncm0 -j ACCEPT
-A INPUT -i rndis0 -j ACCEPT
-A INPUT -i tailscale0 -j ACCEPT
-A INPUT -p icmp -j ACCEPT
# DHCP lease renewals from the router
-A INPUT -p udp --sport 67 --dport 68 -j ACCEPT
# Tailscale direct connections (from anywhere)
-A INPUT -p udp --dport 41641 -j ACCEPT
# Home LAN only: SSH and Samba (SMB2+, port 445 only; NetBIOS is off)
-A INPUT -s 192.168.1.0/24 -p tcp --dport 22 -j ACCEPT
-A INPUT -s 192.168.1.0/24 -p tcp --dport 445 -j ACCEPT
# Add one line per extra service you run, for example a DNS ad blocker:
#   -A INPUT -s 192.168.1.0/24 -p udp --dport 53 -j ACCEPT
# With the kernel v2 config (xt_multiport) several ports fit in one rule:
#   -A INPUT -s 192.168.1.0/24 -p tcp -m multiport --dports 53,80,3000 -j ACCEPT
# aria2 (6800) and its web page (6880) have no rule on purpose: Tailscale only.
COMMIT
