# /etc/conf.d/librespot (S10). Service: /etc/init.d/librespot (Alpine librespot-openrc), runs as user librespot.
# Shows up in Spotify as "S10". Needs Spotify Premium. First login: open Spotify on a phone on the
# home Wi-Fi and pick "S10" in the device list; the login is then cached in /var/lib/librespot.
#
# AUDIO IS SILENT FOR NOW (--backend pipe --device /dev/null) so nothing can hit the speakers before
# the low-volume DAC test and the CamillaDSP volume cap. Later: send it into CamillaDSP instead.
#
# Discovery: built-in mDNS on udp 5353 + zeroconf server on tcp 5354 (both open from the home LAN only).
librespot_args="--name S10 --device-type speaker --bitrate 320 --backend pipe --device /dev/null --system-cache /var/lib/librespot --cache /var/lib/librespot/audio --cache-size-limit 256M --zeroconf-port 5354 --initial-volume 20 --volume-ctrl log"

# Restart it if it exits (e.g. started before Wi-Fi had an address)
supervisor=supervise-daemon
respawn_delay=15
respawn_max=0
